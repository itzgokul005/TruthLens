# ============================================================================
# TruthLens Flask — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Core Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database (SQLAlchemy) ---
# Leave unset to use the default local SQLite file at instance/truthlens.db.
# To use MySQL or PostgreSQL instead, set e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/truthlens
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/truthlens
# DATABASE_URL=

# --- Gemini / Google GenAI ---
# Required for real AI analysis. Without it, the app automatically runs in
# the same local rule-based fallback mode the original React app used when
# no key was configured — it still works, just with heuristic results.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.5-flash

# --- Public URL (used to build password-reset links) ---
APP_URL=http://localhost:5000

# --- Mail (Flask-Mail) — only needed for real "forgot password" emails ---
# Leave MAIL_SUPPRESS_SEND=true (default) to have reset links logged to the
# console instead of emailed — handy for local development.
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@truthlens.local
